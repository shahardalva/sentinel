# Copy to .env and fill in. .env is gitignored; never commit real keys.

# The gateway's upstream key. Needed for make up-real; make up (mock
# upstream) replaces it with a dummy so it never reaches the mock.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Comma-separated keys clients send to the gateway.
SENTINEL_API_KEYS=dev-local-key

# The client key k6 sends in make bench-gateway. Must be one of
# SENTINEL_API_KEYS.
BENCH_API_KEY=dev-local-key
