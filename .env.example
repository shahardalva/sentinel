# Copy to .env and fill in. .env is gitignored; never commit real keys.

# The gateway's upstream key, from the Anthropic Console. Needed only for
# make up-real; make up (mock upstream) replaces it with a dummy so it never
# reaches the mock.
ANTHROPIC_API_KEY=

# Comma-separated keys clients send to the gateway of make up-real. Pick
# your own, for example with: openssl rand -hex 32
# That gateway refuses to start while this is empty. make up ignores it:
# its gateway takes client keys from Postgres, issued through the admin API.
SENTINEL_API_KEYS=

# The admin API's bearer token, required by make up (compose refuses to
# start without it). At least 32 printable ASCII characters, no spaces.
# Generate it, don't pick it: openssl rand -hex 32
# The admin API is on http://127.0.0.1:9465 (see README.md).
SENTINEL_ADMIN_TOKEN=

# Optional: how often the make up gateway fetches the client keys from
# Postgres. A revoked key keeps working for up to this plus two fetch
# timeouts (half of it each, at most 10s): at most twice this, 50s with
# the default. Default 30s.
# SENTINEL_KEYS_REFRESH=30s

# Optional: how long the make up gateway keeps serving its last good key
# set while it can't reach Postgres. Past it, every request gets a 503, so
# a revoked key can't outlive an outage by more than this. At least three
# times SENTINEL_KEYS_REFRESH, so one failed refresh is not an outage; 0
# never expires the set. Default 10m.
# SENTINEL_KEYS_MAX_STALE=10m

# Optional: which upstreams make up-real serves, comma-separated: the
# built-in anthropic and openai, and any named upstreams (see below).
# Defaults to anthropic. Each one listed needs its key above or below.
# make up always serves anthropic, openai and mockcompat, from the mock.
# SENTINEL_UPSTREAMS=anthropic,openai,xai

# Optional: the gateway's key for an OpenAI-compatible API, from the OpenAI
# dashboard or your provider. Needed only when SENTINEL_UPSTREAMS lists
# openai; make up replaces it with a dummy.
# OPENAI_API_KEY=

# Optional: an OpenAI-compatible API other than OpenAI's, including /v1.
# Defaults to https://api.openai.com/v1. Must be https.
# OPENAI_BASE_URL=

# Optional: a named upstream, here xai, for any OpenAI- or
# Anthropic-compatible provider. All three are required, and it is used
# only when SENTINEL_UPSTREAMS lists it. Clients reach it on
# /xai/v1/chat/completions. NAME is the name upper-cased.
# SENTINEL_UPSTREAM_XAI_PROTOCOL=openai
# SENTINEL_UPSTREAM_XAI_BASE_URL=https://api.x.ai/v1
# SENTINEL_UPSTREAM_XAI_API_KEY=

# Optional: the client key for make bench-gateway. It is used only by the
# gateway-bench service, which points at the mock; defaults to "bench".
# BENCH_API_KEY=
